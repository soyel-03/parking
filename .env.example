# Supabase Configuration (add these in Vercel Project Settings -> Environment Variables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional direct PostgreSQL URL (if set, auto-creates tables on first request)
# POSTGRES_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_db_password
